{
  "max_fix_rounds": 2,
  "agent_timeout_seconds": 2400,
  "check_timeout_seconds": 600,
  "setup": [
    [
      "npm",
      "ci",
      "--ignore-scripts"
    ],
    [
      "python3",
      "-m",
      "venv",
      "Backend/.venv"
    ],
    [
      "Backend/.venv/bin/python",
      "-m",
      "pip",
      "install",
      "--quiet",
      "-r",
      "Backend/requirements.txt"
    ]
  ],
  "checks": [
    {
      "name": "Frontend tests",
      "command": [
        "node",
        "--test",
        "tests/*.test.mjs"
      ],
      "required": true
    },
    {
      "name": "Production build",
      "command": [
        "npm",
        "run",
        "build"
      ],
      "required": true
    },
    {
      "name": "Frontend lint",
      "command": [
        "./node_modules/.bin/eslint",
        "src",
        "vite.config.js",
        "eslint.config.js"
      ],
      "required": true
    },
    {
      "name": "npm test script",
      "command": [
        "npm",
        "test"
      ],
      "required": true
    },
    {
      "name": "npm lint script",
      "command": [
        "npm",
        "run",
        "lint"
      ],
      "required": true
    },
    {
      "name": "Backend game API tests",
      "command": [
        "Backend/.venv/bin/python",
        "-W",
        "ignore",
        "-m",
        "unittest",
        "discover",
        "-s",
        "Backend",
        "-p",
        "test_game_detail_api.py"
      ],
      "required": true
    },
    {
      "name": "Weekly PRA tests",
      "command": [
        "Backend/.venv/bin/python",
        "-W",
        "ignore",
        "-m",
        "unittest",
        "discover",
        "-s",
        "Backend",
        "-p",
        "test_weekly_pra.py"
      ],
      "required": true
    },
    {
      "name": "Player name tests",
      "command": [
        "Backend/.venv/bin/python",
        "-W",
        "ignore",
        "-m",
        "unittest",
        "discover",
        "-s",
        "Backend",
        "-p",
        "test_player_names.py"
      ],
      "required": true
    },
    {
      "name": "Scraper feature tests",
      "command": [
        "Backend/.venv/bin/python",
        "-W",
        "ignore",
        "-m",
        "unittest",
        "discover",
        "-s",
        "Backend",
        "-p",
        "test_scraper_features.py"
      ],
      "required": true
    },
    {
      "name": "Backend model tests",
      "command": [
        "Backend/.venv/bin/python",
        "-W",
        "ignore",
        "-m",
        "unittest",
        "discover",
        "-s",
        "Backend",
        "-p",
        "test_nba_ai_model.py"
      ],
      "required": true
    }
  ],
  "constraints": "CourtVision is a React/Vite frontend (src/) and Python/Flask backend (Backend/). Keep backend changes to what the task needs. Do not retrain models, scrape live services, start Postgres, or modify any .pkl/.csv/.json data files. Backend tests must be offline: mock live NBA data fetchers and do not require a database (app.py calls init_db() at import, so tests must patch it or import the route logic without connecting). Match the existing visual language (dark glassmorphic cards, ember-orange accents, existing CSS variables/class conventions). Never weaken, skip, or delete existing test assertions to get a pass; if a failing existing test encodes intended behaviour, change the code to satisfy it; if a test is genuinely obsolete, explain why in your summary before changing it.",
  "claude_model": "opus",
  "codex_model": null
}
